# Local development. In GitHub Actions these live in repository Secrets instead.
# Copy to .env and fill in, then: set -a && source .env && set +a

# Senaryo ve konu üretimi (zorunlu)
ANTHROPIC_API_KEY=

# Video üretimi — video.provider: ltx ise (zorunlu)
LTX_API_KEY=
# LTX API tabanını/yollarını sabitlemek gerekirse (probe komutundan sonra):
# LTX_API_BASE=https://api.ltx.video/v1
# LTX_SUBMIT_PATH=/text-to-video
# LTX_STATUS_PATH=/generations/{id}

# video.provider: fal ise
# FAL_KEY=

# voice.provider: elevenlabs ise
# ELEVENLABS_API_KEY=

# YouTube yükleme (python -m pipeline.cli auth ile üretilir)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
